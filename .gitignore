# ============================================================
# Git 忽略规则 —— 多智能体金融助理项目
# 目的：排除虚拟环境 / 缓存 / 密钥 / 向量库 / 运行日志，避免泄露与超大体积
# ============================================================

# -------- 虚拟环境 --------
venv/
.venv/
env/
**/venv/
**/.venv/

# -------- Python 缓存与构建产物 --------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# -------- 环境变量与密钥（禁止提交）--------
.env
**/.env
*.env.local

# -------- 向量库 / 数据库 --------
**/db_data/

# -------- 运行日志 --------
logs/
**/logs/
*.log
**/run_logs/*_stdout.txt
**/run_logs/smoke.txt

# -------- Gradio 运行时产物（证书/缓存）--------
.gradio/

# -------- 系统与 IDE --------
.DS_Store
.idea/
.vscode/

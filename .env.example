# ============================================================
# LLM 服务商选择(核心配置)
# 通过该变量选择驱动模型,取值:qwen(默认) 或 deepseek
#   选 qwen     -> 只需配置下方 API_KEY,即可运行全套功能(对话+向量化)
#   选 deepseek -> 需配置 DEEPSEEK_API_KEY 驱动对话;
#                  若使用本地RAG检索(Consult Agent),还需配置 API_KEY 做向量化
# ============================================================
LLM_PROVIDER=qwen3.7-plus

# ===== 通义千问(DashScope) API Key =====
# 用于 qwen-plus 对话 与 text-embedding-v1 向量化(RAG 知识库检索)
# 选 LLM_PROVIDER=qwen 时必填;选 deepseek 且不用 RAG 时可不填
API_KEY=your_dashscope_api_key

# ===== DeepSeek API Key(官网 deepseek.com,须支持 function calling) =====
# 选 LLM_PROVIDER=deepseek 时必填
DEEPSEEK_API_KEY=your_deepseek_api_key

# ===== 阿里云百炼 联网检索应用凭证(可选,用于 finance_news_search_consult_tool) =====
# 不填则 Consult Agent 的联网检索功能不可用,其余功能正常
APP_API_KEY=your_bailian_app_api_key
APP_ID=your_bailian_app_id

# ===== MCP 服务器部署的 IP 地址(本机运行使用 127.0.0.1) =====
server_url=127.0.0.1
